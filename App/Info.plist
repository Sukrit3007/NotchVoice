<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <!-- The user-facing name has a space; the bundle identifier, the executable
         and the .app filename deliberately do not. TCC grants (Microphone,
         Accessibility, Input Monitoring) are keyed to the bundle identifier and
         signature, and this app now consumes keystrokes — losing those grants
         means losing the hotkey entirely. Renaming the product would be a
         cosmetic change with a real cost, so only these two keys move. -->
    <key>CFBundleName</key>
    <string>Notch Voice</string>
    <key>CFBundleDisplayName</key>
    <string>Notch Voice</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>NotchVoice records audio only while you hold the dictation key, and transcribes it on your Mac.</string>
</dict>
</plist>
