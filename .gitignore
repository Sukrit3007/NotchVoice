# Generated by XcodeGen — project.yml is the source of truth
*.xcodeproj/
# Keep SwiftPM's resolved dependency graph reproducible even though the rest of
# the generated Xcode project stays ignored.
!NotchVoice.xcodeproj/
NotchVoice.xcodeproj/*
!NotchVoice.xcodeproj/project.xcworkspace/
NotchVoice.xcodeproj/project.xcworkspace/*
!NotchVoice.xcodeproj/project.xcworkspace/xcshareddata/
NotchVoice.xcodeproj/project.xcworkspace/xcshareddata/*
!NotchVoice.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
NotchVoice.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!NotchVoice.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
